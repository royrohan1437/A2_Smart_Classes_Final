{
  "name": "a2-smart-classes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "check": "npm run lint && npm run type-check",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.config.{ts,mts,mjs}\" \"package.json\" \"tsconfig.json\" \".prettierrc.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.config.{ts,mts,mjs}\" \"package.json\" \"tsconfig.json\" \".prettierrc.json\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.7",
    "@radix-ui/react-dialog": "^1.3.1",
    "@supabase/supabase-js": "^2.119.2",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "sonner": "^2.0.8",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "prisma": "^7.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
}
